{
  "name": "pin",
  "productName": "Pin",
  "version": "1.0.0",
  "description": "A local Windows desktop widget workspace",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:check": "node scripts/verify-packaged-app.cjs",
    "make": "electron-forge make",
    "release:portable": "node scripts/release-win.cjs portable",
    "release:installer": "node scripts/release-win.cjs installer",
    "release:win": "node scripts/release-win.cjs all",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "test:db": "node scripts/run-electron-tests.cjs tests/database.test.ts"
  },
  "keywords": [],
  "author": "admin",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "electron": "44.1.0",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "sass": "^1.103.1",
    "tsx": "4.23.13",
    "typescript": "~5.9.3",
    "vite": "^5.0.12"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "^0.45.2",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
